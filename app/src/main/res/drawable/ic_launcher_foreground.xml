<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Vibrant Mesh-Style Gradient Background -->
    <path
        android:pathData="M54,54m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0" android:color="#FF2563EB"/> <!-- Primary Blue -->
                <item android:offset="1" android:color="#FF06B6D4"/> <!-- Secondary Teal -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Subtle Inner Depth Ring -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:alpha="0.2" />

    <!-- 3. Two-Toned Pill (Creates a 3D/Premium Depth) -->
    <!-- Left Half (Pure White) -->
    <path
        android:pathData="M38,44h16v20h-16a10,10 0,0 1,0 -20z"
        android:fillColor="#FFFFFF" />
    <!-- Right Half (Subtle Shade/Light Blue) -->
    <path
        android:pathData="M54,44h16a10,10 0,0 1,0 20h-16v-20z"
        android:fillColor="#E0F2FE" />

    <!-- 4. Catchy Element: The Pulse/Heartbeat Line -->
    <!-- This replaces the simple cross with something more dynamic -->
    <path
        android:pathData="M44,54h4l3,-7l4,14l3,-7h10"
        android:strokeWidth="3.5"
        android:strokeColor="#2563EB"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 5. Decorative Accents (Modern UI Trend) -->
    <path
        android:pathData="M78,38m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#FFFFFF"
        android:alpha="0.6" />
    <path
        android:pathData="M84,44m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0"
        android:fillColor="#FFFFFF"
        android:alpha="0.4" />

</vector>